# ==============================================================================
# Environment Variables Template
# Copy this file to '.env' at the project root and update values as needed:
#   cp .env.example .env
# ==============================================================================

# === Backend Configuration ===
PORT=5000
NODE_ENV=development

# MongoDB connection URI (local instance or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/food_traceability

# JSON Web Token Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (configured for CORS and QR code generation)
FRONTEND_URL=http://localhost:5173

# === Blockchain Configuration (Hardhat) ===
# Local Hardhat JSON-RPC node endpoint
HARDHAT_RPC_URL=http://127.0.0.1:8545

# Deployer private key (Account #0 from 'npx hardhat node' for local development)
# WARNING: NEVER commit your real private keys or production credentials to Git
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed Smart Contract Address (auto-populated by 'npm run deploy' in /contracts)
CONTRACT_ADDRESS=
